<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/background_alternative_item"
    android:backgroundTint="@color/surface_variant">

    <TextView
        android:id="@+id/alternative_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alternative_translation_placeholder"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:maxWidth="200dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        tools:text="Alternative translation" />

</LinearLayout>
