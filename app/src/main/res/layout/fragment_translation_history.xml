<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="4dp"
        app:title="@string/translation_history"
        app:titleTextColor="@color/text_primary" />

    <!-- Search Container -->
    <LinearLayout
        android:id="@+id/search_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:visibility="gone">

        <EditText
            android:id="@+id/search_edit_text"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="@string/search_history"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_disabled"
            android:background="@drawable/background_search_edit_text"
            android:paddingStart="16dp"
            android:paddingEnd="48dp"
            android:gravity="center_vertical"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/clear_search_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_clear"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clear_search"
            android:scaleType="centerInside"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Statistics Container -->
    <LinearLayout
        android:id="@+id/stats_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/surface"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/total_translations_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                tools:text="1,234" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_translations_label"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                tools:text="Total" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/success_rate_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/success_color"
                android:textStyle="bold"
                tools:text="95%" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/success_rate_label"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                tools:text="Success" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/average_confidence_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/confidence_medium"
                android:textStyle="bold"
                tools:text="87%" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/average_confidence_label"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                tools:text="Confidence" />

        </LinearLayout>

    </LinearLayout>

    <!-- Filter Container -->
    <LinearLayout
        android:id="@+id/filter_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_by"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                tools:text="Filter by" />

            <Spinner
                android:id="@+id/sort_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/background_spinner"
                android:padding="8dp"
                android:minWidth="120dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/filter_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start"
            android:layout_marginTop="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/all_filter_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/all_history"
                android:checkable="true"
                android:checked="true"
                style="@style/Widget.Material3.Chip.Filter"
                tools:text="All" />

            <com.google.android.material.chip.Chip
                android:id="@+id/favorites_filter_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/favorites"
                android:checkable="true"
                style="@style/Widget.Material3.Chip.Filter"
                tools:text="Favorites" />

            <com.google.android.material.chip.Chip
                android:id="@+id/successful_filter_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/successful"
                android:checkable="true"
                style="@style/Widget.Material3.Chip.Filter"
                tools:text="Successful" />

            <com.google.android.material.chip.Chip
                android:id="@+id/on_device_filter_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/on_device"
                android:checkable="true"
                style="@style/Widget.Material3.Chip.Filter"
                tools:text="On-device" />

            <com.google.android.material.chip.Chip
                android:id="@+id/cloud_filter_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cloud"
                android:checkable="true"
                style="@style/Widget.Material3.Chip.Filter"
                tools:text="Cloud" />

        </LinearLayout>

    </LinearLayout>

    <!-- History List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/loading_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- History RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_translation_history"
            tools:itemCount="20" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/empty_state_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/empty_state_image_view"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_history_empty"
                android:contentDescription="@string/no_translation_history"
                android:alpha="0.6" />

            <TextView
                android:id="@+id/empty_state_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/no_translation_history"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                tools:text="No translation history" />

            <Button
                android:id="@+id/empty_state_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/clear_history"
                android:textSize="14sp"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
