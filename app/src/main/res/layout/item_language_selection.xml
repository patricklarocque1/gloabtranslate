<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:minHeight="64dp">

    <!-- Flag -->
    <TextView
        android:id="@+id/flag_text_view"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginEnd="16dp"
        tools:text="🇺🇸" />

    <!-- Language Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="English" />

        <TextView
            android:id="@+id/native_name_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="English" />

    </LinearLayout>

    <!-- Language Code -->
    <TextView
        android:id="@+id/code_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_disabled"
        android:background="@drawable/background_language_code"
        android:padding="6dp"
        android:layout_marginEnd="8dp"
        android:minWidth="32dp"
        android:gravity="center"
        tools:text="EN" />

    <!-- Support Indicator -->
    <ImageView
        android:id="@+id/support_indicator"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_on_device"
        android:contentDescription="@string/on_device_supported"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Favorite Indicator -->
    <ImageView
        android:id="@+id/favorite_indicator"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_favorite_filled"
        android:contentDescription="@string/favorite_language"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Selected Indicator -->
    <ImageView
        android:id="@+id/selected_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check_circle"
        android:contentDescription="@string/selected_language"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
