<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary">

    <!-- Header Container -->
    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_language"
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                tools:text="Select Language" />

            <TextView
                android:id="@+id/subtitle_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_language_for_translation"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                tools:text="Choose a language for translation" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_language_selection"
            android:scaleType="centerInside" />

    </LinearLayout>

    <!-- Search Container -->
    <LinearLayout
        android:id="@+id/search_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/surface">

        <EditText
            android:id="@+id/search_edit_text"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="@string/search_languages"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_disabled"
            android:background="@drawable/background_search_edit_text"
            android:paddingStart="16dp"
            android:paddingEnd="48dp"
            android:gravity="center_vertical"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/clear_search_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_clear"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clear_search"
            android:scaleType="centerInside"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Filter Container -->
    <LinearLayout
        android:id="@+id/filter_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/surface">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_by"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"
            tools:text="Filter by" />

        <LinearLayout
            android:id="@+id/filter_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start">

            <com.google.android.material.chip.Chip
                android:id="@+id/all_filter_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/all_languages"
                android:checkable="true"
                android:checked="true"
                style="@style/Widget.Material3.Chip.Filter"
                tools:text="All" />

            <com.google.android.material.chip.Chip
                android:id="@+id/recent_filter_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/recent_languages"
                android:checkable="true"
                style="@style/Widget.Material3.Chip.Filter"
                tools:text="Recent" />

            <com.google.android.material.chip.Chip
                android:id="@+id/favorites_filter_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/favorite_languages"
                android:checkable="true"
                style="@style/Widget.Material3.Chip.Filter"
                tools:text="Favorites" />

            <com.google.android.material.chip.Chip
                android:id="@+id/on_device_filter_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/on_device_languages"
                android:checkable="true"
                style="@style/Widget.Material3.Chip.Filter"
                tools:text="On-device" />

            <com.google.android.material.chip.Chip
                android:id="@+id/cloud_filter_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cloud_languages"
                android:checkable="true"
                style="@style/Widget.Material3.Chip.Filter"
                tools:text="Cloud" />

        </LinearLayout>

    </LinearLayout>

    <!-- Languages List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/loading_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Languages RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/languages_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_language_selection"
            tools:itemCount="10" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/empty_state_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/empty_state_image_view"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_language_not_found"
                android:contentDescription="@string/no_languages_found"
                android:alpha="0.6" />

            <TextView
                android:id="@+id/empty_state_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/no_languages_found"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                tools:text="No languages found" />

            <Button
                android:id="@+id/empty_state_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/clear_search"
                android:textSize="14sp"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
